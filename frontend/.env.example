# Google OAuth client ID from GCP Console > APIs & Services > Credentials
# (Web application type, with http://localhost:5173 as authorized JavaScript origin)
# Leave blank for demo mode.
VITE_GOOGLE_CLIENT_ID=

# Google Sheets spreadsheet ID (the long string in the Sheet URL between /d/ and /edit)
# Leave blank for demo mode.
VITE_SPREADSHEET_ID=

# Enable demo mode at build time. Set to "true" for local dev without Google auth.
# Also requires ?demo=true in the URL at runtime (dual-gate safety check).
VITE_DEMO_MODE=true
